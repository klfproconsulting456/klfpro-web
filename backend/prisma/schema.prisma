generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  AGENT
}

model User {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

model Lead {
  id             String   @id @default(cuid())
  fullName       String
  phone          String
  email          String
  loanTypeId     String
  loanType       LoanType @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  assignedToId   String?
  status         String   @default("NEW")
  message        String?
  loanAmount     Decimal? @db.Decimal(12, 2)
  monthlyIncome  Decimal? @db.Decimal(12, 2)
  employmentType String?
  existingEmi    Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  timeline       LeadTimeline[]
  documents      Document[]

  @@index([status])
  @@index([createdAt])
}

model LoanType {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  leads       Lead[]
}

model LoanApplication {
  id        String   @id @default(cuid())
  userId    String?
  leadId    String?
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("UNDER_REVIEW")
  createdAt DateTime @default(now())
}

model Calculation {
  id          String   @id @default(cuid())
  userId      String?
  type        String
  inputJson   Json
  outputJson  Json
  createdAt   DateTime @default(now())
}

model Offer {
  id            String   @id @default(cuid())
  applicationId String
  lenderName    String
  interestRate  Decimal  @db.Decimal(5, 2)
  tenureMonths  Int
  createdAt     DateTime @default(now())
}

model ApplicationStatusHistory {
  id            String   @id @default(cuid())
  applicationId String
  status        String
  note          String?
  createdAt     DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  publishedAt DateTime @default(now())
}

model ContactQuery {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String
  message   String
  createdAt DateTime @default(now())
}
model CustomerSession {
  id           String   @id @default(cuid())
  phone        String
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([phone])
  @@index([refreshToken])
}

model LeadTimeline {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage       String   // e.g. LEAD_CREATED, DOCS_SUBMITTED, VERIFICATION, SANCTION, DISBURSEMENT
  description String?
  createdAt   DateTime @default(now())

  @@index([leadId])
}

model SeoPage {
  id               String   @id @default(cuid())
  slug             String   @unique // e.g. delhi/home-loan
  city             String
  service          String
  title            String
  metaDescription  String
  h1               String
  content          String   @db.Text
  faqs             Json?    // Array of FAQ objects
  interestRate     Decimal? @db.Decimal(5, 2)
  qualityScore     Int      @default(100) // Quality of page
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([city, service])
  @@index([slug])
}

model OtpStore {
  id        String   @id @default(cuid())
  phone     String   @unique
  otp       String
  expiresAt DateTime
  attempts  Int      @default(0)
  lockedUntil DateTime?
  createdAt DateTime @default(now())
}

model SecurityLog {
  id             String   @id @default(cuid())
  phone          String?
  eventType      String   // OTP_REQUESTED, OTP_VERIFIED, OTP_FAILED, ACCOUNT_LOCKED, TOKEN_REFRESH, LOGOUT
  ipAddress      String?
  deviceInfo     String?
  userAgent      String?
  riskScore      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([phone])
  @@index([createdAt(sort: Desc)])
}

model SeoQualityFailure {
  id          String   @id @default(cuid())
  slug        String   @unique
  score       Int
  reasons     Json     // e.g., ["Thin content", "Missing FAQs"]
  createdAt   DateTime @default(now())
}

model SeoGenerationJob {
  id          String   @id @default(cuid())
  slug        String   @unique
  city        String
  service     String
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Document {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name      String
  type      String   // e.g. IDENTITY, INCOME, ADDRESS
  fileUrl   String
  status    String   @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, REJECTED
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
}
